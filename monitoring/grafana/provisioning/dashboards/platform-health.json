{
  "dashboard": {
    "id": null,
    "title": "Log Platform - Overall Health",
    "tags": ["log-platform", "overview"],
    "timezone": "UTC",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "type": "stat",
        "title": "Service Availability",
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "up{application=~\"identity-service|api-gateway|ingestion-service|processing-service|query-service|alert-service|notification-service\"}",
            "legendFormat": "{{application}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "1", "text": "UP", "color": "green"},
              {"type": "value", "value": "0", "text": "DOWN", "color": "red"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "type": "graph",
        "title": "HTTP Request Rate",
        "gridPos": {"x": 4, "y": 0, "w": 8, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_total{application=~\"identity-service|api-gateway|ingestion-service|processing-service|query-service|alert-service|notification-service\"}[1m])) by (application)",
            "legendFormat": "{{application}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "HTTP Error Rate (5xx)",
        "gridPos": {"x": 12, "y": 0, "w": 8, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_total{status=~\"5..\",application=~\"identity-service|api-gateway|ingestion-service|processing-service|query-service|alert-service|notification-service\"}[1m])) by (application)",
            "legendFormat": "{{application}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "JVM Heap Memory Used",
        "gridPos": {"x": 0, "y": 4, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{area=\"heap\",application=~\"identity-service|api-gateway|ingestion-service|processing-service|query-service|alert-service|notification-service\"}",
            "legendFormat": "{{application}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "JVM GC Pause Time",
        "gridPos": {"x": 6, "y": 4, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(jvm_gc_pause_seconds_sum{application=~\"identity-service|api-gateway|ingestion-service|processing-service|query-service|alert-service|notification-service\"}[1m])",
            "legendFormat": "{{application}} {{action}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "CPU Usage",
        "gridPos": {"x": 12, "y": 4, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "process_cpu_usage{application=~\"identity-service|api-gateway|ingestion-service|processing-service|query-service|alert-service|notification-service\"}",
            "legendFormat": "{{application}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "DB Connection Pool Active",
        "gridPos": {"x": 18, "y": 4, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "hikaricp_connections_active{application=~\"identity-service|processing-service|query-service|alert-service|notification-service\"}",
            "legendFormat": "{{application}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Log Ingestion Rate",
        "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(logs_ingested_total{application=\"ingestion-service\"}[1m])",
            "legendFormat": "ingested",
            "refId": "A"
          },
          {
            "expr": "rate(logs_ingested_rejected{application=\"ingestion-service\"}[1m])",
            "legendFormat": "rejected",
            "refId": "B"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Log Processing Rate",
        "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(logs_processed_total{application=\"processing-service\"}[1m])",
            "legendFormat": "processed",
            "refId": "A"
          },
          {
            "expr": "rate(logs_processed_failed{application=\"processing-service\"}[1m])",
            "legendFormat": "failed",
            "refId": "B"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Alert Evaluation Duration",
        "gridPos": {"x": 12, "y": 8, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(alert_evaluation_duration_seconds_bucket{application=\"alert-service\"}[1m]))",
            "legendFormat": "p95",
            "refId": "A"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Notifications Delivered",
        "gridPos": {"x": 18, "y": 8, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(notifications_delivered_total{application=\"notification-service\"}[1m])",
            "legendFormat": "success",
            "refId": "A"
          },
          {
            "expr": "rate(notifications_delivered_failed{application=\"notification-service\"}[1m])",
            "legendFormat": "failed",
            "refId": "B"
          }
        ]
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    }
  },
  "overwrite": true
}
